<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin — Disponibilités</title>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Mono:wght@300;400&family=Outfit:wght@100;200&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0a0a09; --white: #f0ede8; --muted: #55554f;
      --accent: #c8b89a; --line: #1e1e1c;
      --dispo: #7a9b6e; --occupe: #c17a4e; --weekend: #8a7ca0; --past: #2b2b28; --empty: var(--bg);
      --dispo-wash: rgba(111,175,82,.32); --occupe-wash: rgba(210,108,58,.30); --weekend-wash: rgba(134,98,178,.30);
    }
    body {
      background: var(--bg); color: var(--white);
      font-family: 'DM Mono', monospace; cursor: none;
      min-height: 100vh;
    }
    :focus-visible { outline: 1px solid var(--accent); outline-offset: 3px; }

    /* ── Curseur ── */
    #cursor {
      position: fixed; z-index: 9999; pointer-events: none;
      mix-blend-mode: difference; left: -80px; top: -80px;
      transform: translate(-50%, -50%); width: 36px; height: 36px;
    }
    #cursor::before, #cursor::after {
      content: ""; position: absolute; top: 50%; left: 50%;
      width: 32px; height: 2px; background: rgba(255,255,255,0.95);
      transform-origin: center;
    }
    #cursor::before { transform: translate(-50%, -50%) rotate(45deg); }
    #cursor::after  { transform: translate(-50%, -50%) rotate(-45deg); }

    header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 48px; height: 64px; border-bottom: 1px solid var(--line);
    }
    .hdr-name {
      font-family: 'Outfit', sans-serif; font-weight: 100;
      font-size: .75rem; letter-spacing: .2em; text-transform: uppercase; color: var(--accent);
    }
    .hdr-role { font-size: .56rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-top: 4px; }
    .badge {
      font-size: .56rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted);
      border: 1px solid var(--line); padding: 6px 14px;
    }

    main { max-width: 760px; margin: 0 auto; padding: 56px 32px 80px; }
    .eyebrow { font-size: .58rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin-bottom: 18px; }
    h1 {
      font-family: 'Bebas Neue', sans-serif; font-size: clamp(2rem, 5vw, 3rem);
      letter-spacing: .04em; line-height: .95; margin-bottom: 20px;
    }
    .howto {
      font-size: .74rem; line-height: 1.75; color: var(--muted);
      max-width: 58ch; margin-bottom: 36px;
    }
    .howto strong { color: var(--white); font-weight: 400; }

    .legend { display: flex; gap: 22px; flex-wrap: wrap; margin-bottom: 28px; }
    .legend-item { display: flex; align-items: center; gap: 9px; font-size: .56rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
    .swatch { width: 11px; height: 11px; flex-shrink: 0; }
    .swatch.dispo   { background: var(--dispo); }
    .swatch.occupe  { background: var(--occupe); }
    .swatch.weekend { background: var(--weekend); }
    .swatch.past    { background: var(--past); border: 1px solid var(--line); }

    .cal-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
    #cal-title { font-family: 'Bebas Neue', sans-serif; font-size: 1.4rem; letter-spacing: .06em; }
    .nav-btn {
      background: none; border: 1px solid var(--line); color: var(--white);
      width: 34px; height: 34px; cursor: none;
      font-family: 'DM Mono', monospace; font-size: .9rem;
      transition: border-color .2s ease, color .2s ease;
    }
    .nav-btn:hover { border-color: var(--accent); color: var(--accent); }
    .nav-btn:disabled { opacity: .25; cursor: default; }

    .weekdays { display: grid; grid-template-columns: repeat(7, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
    .weekdays div {
      padding: 10px 0; text-align: center; font-size: .56rem; letter-spacing: .12em; text-transform: uppercase;
      color: var(--muted); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line);
    }
    .grid { display: grid; grid-template-columns: repeat(7, 1fr); border-left: 1px solid var(--line); margin-bottom: 44px; }
    .day {
      aspect-ratio: 1 / 0.85; min-height: 56px;
      border-right: 1px solid var(--line); border-bottom: 1px solid var(--line);
      padding: 8px; position: relative; display: flex; flex-direction: column; justify-content: space-between;
    }
    .day .num { font-size: .68rem; color: var(--white); }
    .day .status { font-size: .48rem; letter-spacing: .08em; text-transform: uppercase; }
    .day.dispo   { background: var(--dispo-wash); cursor: none; }
    .day.dispo   .status { color: var(--dispo); }
    .day.occupe  { background: var(--occupe-wash); cursor: none; }
    .day.occupe  .status { color: var(--occupe); }
    .day.weekend { background: var(--weekend-wash); cursor: none; }
    .day.weekend .status { color: var(--weekend); }
    .day.past, .day.empty { background: var(--past); }
    .day.empty { background: var(--empty); }
    .day.past .num { color: var(--muted); }
    .day.clickable:hover { outline: 1px solid var(--accent); outline-offset: -1px; }

    .output-block { margin-top: 8px; }
    .output-label {
      font-size: .58rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted);
      margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between;
    }
    textarea {
      width: 100%; min-height: 140px; background: #100f0d; color: var(--white);
      border: 1px solid var(--line); padding: 16px; font-family: 'DM Mono', monospace;
      font-size: .68rem; line-height: 1.6; resize: vertical;
    }
    .btn-row { display: flex; gap: 10px; margin-top: 12px; flex-wrap: wrap; }
    .btn {
      background: none; border: 1px solid var(--line); color: var(--white);
      padding: 12px 22px; cursor: none; font-family: 'DM Mono', monospace;
      font-size: .6rem; letter-spacing: .14em; text-transform: uppercase;
      transition: border-color .2s ease, background .2s ease;
    }
    .btn:hover { border-color: var(--accent); background: rgba(200,184,154,.06); }
    .btn.copied { border-color: var(--dispo); color: var(--dispo); }

    .import-section { margin-top: 56px; padding-top: 36px; border-top: 1px solid var(--line); }
    .import-section .howto { margin-bottom: 16px; }

    @media (max-width: 560px) {
      header { padding: 0 24px; }
      main { padding: 48px 20px 56px; }
      .day { min-height: 44px; padding: 6px; }
      .day .num { font-size: .6rem; }
      .day .status { font-size: .4rem; }
    }
  </style>
</head>
<body>

<div id="cursor"></div>

<header>
  <div>
    <div class="hdr-name">Mahé Richard-Schmidt</div>
    <div class="hdr-role">Monteur vidéo</div>
  </div>
  <div class="badge">Outil privé — non lié au site public</div>
</header>

<main>
  <div class="eyebrow">Administration</div>
  <h1>Éditer les disponibilités</h1>
  <p class="howto">
    <strong>Clique sur un jour</strong> pour basculer entre Disponible et Occupé.
    Le code se met à jour automatiquement en bas de page — il ne te reste qu'à le
    copier et le coller dans le tableau <strong>OCCUPE</strong> de
    <strong>calendar/index.html</strong> sur GitHub. Ton état est sauvegardé dans ce
    navigateur, tu peux fermer et revenir plus tard.
  </p>

  <div class="legend">
    <div class="legend-item"><span class="swatch dispo"></span>Disponible</div>
    <div class="legend-item"><span class="swatch occupe"></span>Occupé (cliqué)</div>
    <div class="legend-item"><span class="swatch weekend"></span>Week-end</div>
    <div class="legend-item"><span class="swatch past"></span>Passé</div>
  </div>

  <div class="cal-nav">
    <button class="nav-btn" id="prev" aria-label="Mois précédent">←</button>
    <div id="cal-title"></div>
    <button class="nav-btn" id="next" aria-label="Mois suivant">→</button>
  </div>

  <div class="weekdays">
    <div>Lun</div><div>Mar</div><div>Mer</div><div>Jeu</div><div>Ven</div><div>Sam</div><div>Dim</div>
  </div>
  <div class="grid" id="grid"></div>

  <div class="output-block">
    <div class="output-label">
      <span>Code à coller dans calendar/index.html</span>
      <span id="count"></span>
    </div>
    <textarea id="output" readonly></textarea>
    <div class="btn-row">
      <button class="btn" id="copy-btn">Copier le code</button>
      <button class="btn" id="clear-btn">Tout effacer</button>
    </div>
  </div>

  <div class="import-section">
    <p class="howto">
      Si tu as déjà des dates enregistrées sur le site (dans le fichier GitHub) et que
      cet outil part de zéro, colle ici le contenu actuel de ton tableau OCCUPE pour
      reprendre exactement où tu en es.
    </p>
    <textarea id="import-input" placeholder="const OCCUPE = [ '261001','261002', ... ];" style="min-height:90px;"></textarea>
    <div class="btn-row">
      <button class="btn" id="import-btn">Importer ces dates</button>
    </div>
  </div>
</main>

<script>
const MOIS = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];
const STORAGE_KEY = 'mahe-dispo-occupe';

// ── Curseur ──
const cursor = document.getElementById('cursor');
document.addEventListener('mousemove', e => {
  cursor.style.left = e.clientX + 'px';
  cursor.style.top  = e.clientY + 'px';
});

const today = new Date();
today.setHours(0,0,0,0);

let viewYear  = today.getFullYear();
let viewMonth = today.getMonth();

let OCCUPE = new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'));

const gridEl    = document.getElementById('grid');
const titleEl   = document.getElementById('cal-title');
const prevBtn   = document.getElementById('prev');
const nextBtn   = document.getElementById('next');
const outputEl  = document.getElementById('output');
const countEl   = document.getElementById('count');
const copyBtn   = document.getElementById('copy-btn');
const clearBtn  = document.getElementById('clear-btn');
const importIn  = document.getElementById('import-input');
const importBtn = document.getElementById('import-btn');

function toKey(y, m, d) {
  return `${String(y).slice(-2)}${String(m + 1).padStart(2, '0')}${String(d).padStart(2, '0')}`;
}

function save() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify([...OCCUPE]));
  updateOutput();
}

function updateOutput() {
  const sorted = [...OCCUPE].sort();
  countEl.textContent = `${sorted.length} date${sorted.length !== 1 ? 's' : ''}`;
  if (sorted.length === 0) {
    outputEl.value = `const OCCUPE = [\n];`;
    return;
  }
  let lines = '';
  for (let i = 0; i < sorted.length; i += 6) {
    lines += '  ' + sorted.slice(i, i + 6).map(k => `'${k}'`).join(',') + ',\n';
  }
  outputEl.value = `const OCCUPE = [\n${lines}];`;
}

function renderGrid() {
  titleEl.textContent = `${MOIS[viewMonth]} ${viewYear}`;
  gridEl.innerHTML = '';

  const firstOfMonth  = new Date(viewYear, viewMonth, 1);
  const daysInMonth   = new Date(viewYear, viewMonth + 1, 0).getDate();
  const leadingBlanks = (firstOfMonth.getDay() + 6) % 7;

  for (let i = 0; i < leadingBlanks; i++) {
    const cell = document.createElement('div');
    cell.className = 'day empty';
    gridEl.appendChild(cell);
  }

  for (let d = 1; d <= daysInMonth; d++) {
    const date   = new Date(viewYear, viewMonth, d);
    const key    = toKey(viewYear, viewMonth, d);
    const isPast = date < today;
    const isWknd = date.getDay() === 0 || date.getDay() === 6;
    const isBooked = OCCUPE.has(key);

    const cell = document.createElement('div');
    let status = '';
    if (isPast) {
      cell.className = 'day past';
    } else {
      cell.className = 'day clickable ' + (isBooked ? 'occupe' : (isWknd ? 'weekend' : 'dispo'));
      status = isBooked ? 'Occupé' : (isWknd ? 'Week-end' : 'Dispo');
      cell.addEventListener('click', () => {
        if (OCCUPE.has(key)) OCCUPE.delete(key); else OCCUPE.add(key);
        save();
        renderGrid();
      });
    }
    cell.innerHTML = `<div class="num">${d}</div><div class="status">${status}</div>`;
    gridEl.appendChild(cell);
  }

  const trailingBlanks = (7 - ((leadingBlanks + daysInMonth) % 7)) % 7;
  for (let i = 0; i < trailingBlanks; i++) {
    const cell = document.createElement('div');
    cell.className = 'day empty';
    gridEl.appendChild(cell);
  }

  prevBtn.disabled = viewYear === today.getFullYear() && viewMonth === today.getMonth();
}

prevBtn.addEventListener('click', () => {
  viewMonth--;
  if (viewMonth < 0) { viewMonth = 11; viewYear--; }
  renderGrid();
});
nextBtn.addEventListener('click', () => {
  viewMonth++;
  if (viewMonth > 11) { viewMonth = 0; viewYear++; }
  renderGrid();
});

copyBtn.addEventListener('click', () => {
  navigator.clipboard.writeText(outputEl.value).then(() => {
    copyBtn.textContent = 'Copié !';
    copyBtn.classList.add('copied');
    setTimeout(() => { copyBtn.textContent = 'Copier le code'; copyBtn.classList.remove('copied'); }, 1600);
  });
});

clearBtn.addEventListener('click', () => {
  if (!confirm('Effacer toutes les dates marquées comme occupées ?')) return;
  OCCUPE = new Set();
  save();
  renderGrid();
});

importBtn.addEventListener('click', () => {
  const matches = importIn.value.match(/'(\d{6})'/g) || [];
  if (matches.length === 0) {
    alert("Aucune date au format '261010' trouvée dans le texte collé.");
    return;
  }
  OCCUPE = new Set(matches.map(m => m.replace(/'/g, '')));
  save();
  renderGrid();
  importIn.value = '';
});

renderGrid();
updateOutput();
</script>
</body>
</html>
